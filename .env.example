# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Password for the dashboard (user name is "owner"). Required in production.
APP_PASSWORD=

# "demo" (default, fictional company) or "google" (real Workspace tenant)
DATA_SOURCE=demo

# "true" = public demo for recruiters: no password, one private copy per visitor,
# 20 checks per hour, data deleted after 7 days. Ignored when DATA_SOURCE=google.
PUBLIC_DEMO=false

# Optional: Claude API key for AI explanations. Without it, standard templates are used.
ANTHROPIC_API_KEY=

# Optional: where the SQLite file lives (default: ./data/app.db)
DATABASE_PATH=

# --- Only for DATA_SOURCE=google (see README) ---
# Full JSON key of the service account, on ONE line
GOOGLE_SERVICE_ACCOUNT_JSON=
# A super admin of the tenant the service account acts as
GOOGLE_ADMIN_EMAIL=
# Primary domain of the tenant, e.g. mycompany.com
GOOGLE_DOMAIN=
